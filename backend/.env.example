NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/university-study-hub
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
UNIVERSITY_ID=demo-university
ADMIN_EMAIL=admin@university.edu
ADMIN_PASSWORD=change-me-before-seeding
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@university-study-hub.local
STORAGE_PROVIDER=local
STORAGE_ENABLED_PROVIDERS=local
STORAGE_DEFAULT_PROVIDER=local
STORAGE_UPLOAD_POLICY=default
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=

# Google Drive storage (enable by adding google-drive to STORAGE_ENABLED_PROVIDERS)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30
UPLOAD_RATE_LIMIT_MAX=20

# Social Login: Google OAuth 2.0 / OIDC
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Social Login: GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback

# Social Login: Microsoft OAuth 2.0 / Entra ID
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:4000/api/auth/microsoft/callback

# University Email Policy
AUTH_REQUIRE_UNIVERSITY_EMAIL=false
ALLOWED_EMAIL_DOMAINS=silicon.ac.in,university.edu
